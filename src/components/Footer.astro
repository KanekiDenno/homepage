---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="site-footer-inner">
		<div class="site-footer-left">
			<img src="/kaneki-denno-icon.png" alt="金木電王" />
			<div>
				<div class="site-footer-title">金木電王</div>
				<div class="site-footer-sub">Kaneki Denno Innovation</div>
			</div>
		</div>
		<div class="site-footer-links">
			<a href="/about">会社概要</a>
			<a href="/privacy">プライバシーポリシー</a>
			<a href="/terms">利用規約</a>
			<a href="mailto:ou.kaneki@kaneki-denno.com">ou.kaneki@kaneki-denno.com</a>
		</div>
		<div class="site-footer-copy">© {currentYear} KANEKI DENNO. All rights reserved.</div>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--border);
		background: var(--bg);
		padding: 40px 48px;
	}

	.site-footer-inner {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 24px;
	}

	.site-footer-left {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.site-footer-left img {
		width: 32px;
		height: 32px;
		object-fit: contain;
	}

	.site-footer-title {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.9rem;
		letter-spacing: 0.05em;
	}

	.site-footer-sub,
	.site-footer-copy,
	.site-footer-links a {
		font-family: var(--font-mono);
		font-size: 0.6rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--gray);
	}

	.site-footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 16px 24px;
		justify-content: center;
	}

	.site-footer-links a:hover {
		color: var(--white);
	}

	@media (max-width: 900px) {
		.site-footer {
			padding: 32px 24px;
		}

		.site-footer-inner {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.site-footer-left {
			justify-content: center;
		}
	}
</style>
