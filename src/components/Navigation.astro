---
const navItems = [
	{ label: 'サービス', href: '/#value' },
	{ label: '詳細', href: '/#services' },
	{ label: '強み', href: '/#strength' },
	{ label: '会社概要', href: '/about' },
];
---

<nav class="site-nav">
	<div class="site-nav-inner">
		<a href="/" class="site-logo">
			<img src="/kaneki-denno-icon.png" alt="金木電王" />
			<div>
				<div class="site-logo-text">金木電王</div>
				<div class="site-logo-sub">Kaneki Denno</div>
			</div>
		</a>
		<ul class="site-nav-links">
			{navItems.map((item) => (
				<li>
					<a href={item.href}>{item.label}</a>
				</li>
			))}
		</ul>
		<a href="/#contact" class="site-nav-cta">お問合せ</a>
	</div>
</nav>

<style>
	.site-nav {
		position: fixed;
		inset: 0 0 auto;
		z-index: 100;
		padding: 20px 48px;
		border-bottom: 1px solid var(--border);
		background: linear-gradient(to bottom, rgba(6, 6, 6, 0.95) 0%, transparent 100%);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}

	.site-nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}

	.site-logo {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.site-logo img {
		width: 40px;
		height: 40px;
		object-fit: contain;
	}

	.site-logo-text {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.05rem;
		letter-spacing: 0.08em;
		line-height: 1.1;
	}

	.site-logo-sub {
		font-family: var(--font-mono);
		font-size: 0.55rem;
		letter-spacing: 0.25em;
		color: var(--gray);
		text-transform: uppercase;
	}

	.site-nav-links {
		display: flex;
		gap: 36px;
		margin-left: auto;
		list-style: none;
	}

	.site-nav-links a {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--gray);
		transition: color 0.2s;
	}

	.site-nav-links a:hover {
		color: var(--white);
	}

	.site-nav-cta {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--bg);
		background: var(--accent);
		padding: 10px 22px;
		clip-path: polygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%);
		transition: opacity 0.2s;
	}

	.site-nav-cta:hover {
		opacity: 0.85;
	}

	@media (max-width: 900px) {
		.site-nav {
			padding: 16px 24px;
		}

		.site-nav-links {
			display: none;
		}

		.site-nav-cta {
			padding-inline: 16px;
		}

		.site-logo-sub {
			display: none;
		}
	}
</style>
