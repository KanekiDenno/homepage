---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="会社概要 | 金木電王">
	<Navigation />
	<main class="page-shell legal-page">
		<div class="page-wrap">
			<header class="page-header">
				<div class="page-label">About</div>
				<h1>会社概要</h1>
				<p>
					金木電王は、広告代理店や制作組織向けに、AI導入、業務自動化、社内人材育成を一体で支援するコンサルティング事業です。
				</p>
			</header>

			<div class="legal-grid">
				<section class="page-card legal-card">
					<h2>事業概要</h2>
					<p>
						現場のワークフローを起点に、生成AI活用、運用設計、自動化実装、内製化支援までを一気通貫で提供します。導入して終わらない実務定着を重視しています。
					</p>
				</section>

				<section class="page-card legal-card">
					<h2>提供サービス</h2>
					<ul>
						<li>AI導入コンサルティング</li>
						<li>業務フローの自動化設計と実装支援</li>
						<li>社内研修、運用定着、内製化支援</li>
						<li>広告クリエイティブ制作業務の改善支援</li>
					</ul>
				</section>

				<section class="page-card legal-card">
					<h2>事業者情報</h2>
					<dl>
						<dt>屋号</dt>
						<dd>金木電王</dd>
						<dt>代表</dt>
						<dd>金木 電王</dd>
						<dt>事業形態</dt>
						<dd>個人事業</dd>
					</dl>
				</section>

				<section class="page-card legal-card">
					<h2>お問い合わせ</h2>
					<dl>
						<dt>メールアドレス</dt>
						<dd><a href="mailto:ou.kaneki@kaneki-denno.com">ou.kaneki@kaneki-denno.com</a></dd>
						<dt>営業時間</dt>
						<dd>平日 10:00 - 18:00</dd>
					</dl>
				</section>
			</div>
		</div>
	</main>
	<Footer />
</Layout>

<style>
	.legal-page {
		padding-bottom: 96px;
	}

	.page-header {
		padding: 56px 0 40px;
		max-width: 760px;
	}

	.page-header h1 {
		margin: 18px 0 20px;
		font-size: clamp(2.8rem, 6vw, 4.5rem);
		font-weight: 800;
	}

	.page-header p {
		font-size: 1rem;
		line-height: 1.9;
		color: rgba(255, 255, 255, 0.6);
	}

	.legal-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
	}

	.legal-card {
		padding: 32px;
	}

	.legal-card h2 {
		margin-bottom: 18px;
		font-size: 1.35rem;
		font-weight: 700;
	}

	.legal-card p,
	.legal-card li,
	.legal-card dd,
	.legal-card a {
		color: rgba(255, 255, 255, 0.62);
		line-height: 1.9;
	}

	.legal-card ul {
		list-style: none;
	}

	.legal-card li {
		position: relative;
		padding-left: 18px;
	}

	.legal-card li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.9em;
		width: 8px;
		height: 1px;
		background: var(--accent);
	}

	.legal-card dl {
		display: grid;
		grid-template-columns: 120px 1fr;
		gap: 14px 20px;
	}

	.legal-card dt {
		font-weight: 700;
	}

	.legal-card a:hover {
		color: var(--white);
	}

	@media (max-width: 900px) {
		.legal-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
